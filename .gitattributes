# Enforce LF line endings for all text files
* text=auto eol=lf

# Python files
*.py text diff=python

# Markdown
*.md text diff=markdown

# YAML
*.yaml text
*.yml text

# HTML/CSS/JS
*.html text
*.css text
*.js text

# Config
*.cfg text
*.ini text
*.toml text

# Binaries
*.png binary
*.jpg binary
*.ico binary
*.db binary
